# PostgreSQL Database (Neon / Supabase DB)
DATABASE_URL="postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require"

# Auth.js v5 Secret (Generate using: npx auth secret)
AUTH_SECRET="your-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional Production Seed Admin Credentials (Custom Admin Account)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="your-secure-password-here"

# Cloudflare R2 Storage (10 GB Free Forever S3-Compatible Storage)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="maganghan-attendance"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://pub-xyz.r2.dev"

# Web Push VAPID Keys (Generate using: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@maganghan.com"
